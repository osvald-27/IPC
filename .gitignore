utilities/*.dat
utilities/*.dat.tmp
utilities/*.tmp
utilities/*.db
utilities/*.log
utilities/*.key
bank.dat
bank.dat.tmp
transactions.log
ipc.key

# Keep environment templates or .gitkeep placeholders tracked
!.gitkeep
!.env
!.gitignore
