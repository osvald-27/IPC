# Compiled object files and executables
*.o
*.obj
*.exe
*.out
Lin/ipc/server_app
Lin/ipc/client_app
Win/ipc/server_app.exe
Win/ipc/client_app.exe

# Editor backup and temporary files
*.save
*.swp
*.swo
*~

