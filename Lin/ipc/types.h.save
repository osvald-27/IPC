
#ifndef TYPES_H
#define TYPES_H

#include <stdint.h>
#include <stddef.h>

/* Protocol and system limits */
#define CLIENT_ID_LENGTH       7U
#define MAX_CLIENTS            1000U
#define TRANSACTION_ID     36U
#define IPC_MAX_REQUEST_ID         36U
#define IPC_MAX_SESSION_ID         36U

#define IPC_CURRENCY_CODE_LENGTH   3U
#define IPC_CURRENCY_CODE          "XAF"

/*
 * Monetary values use integer minor units.
 * Never use float or double for account balances.
 */
typedef int64_t ipc_money_t;

typedef struct {
    char value[IPC_CLIENT_ID_LENGTH + 1U];
} ipc_client_id_t;

typedef struct {
    char value[IPC_MAX_TRANSACTION_ID + 1U];
} ipc_transaction_id_t;

typedef struct {
    char value[IPC_MAX_REQUEST_ID + 1U];
} ipc_request_id_t;

typedef struct {
    char value[IPC_MAX_SESSION_ID + 1U];
} ipc_session_id_t;

/*
 * Account state is authoritative on the server.
 * Clients must not modify this structure directly.
 */
typedef struct {
    ipc_client_id_t client_id;

    ipc_money_t balance;
    ipc_money_t total_deposits;
    ipc_money_t total_withdrawals;

    uint64_t version;
    uint32_t flags;
    uint32_t reserved;
} ipc_account_t;

#endif /* CROSSIPC_TYPES_H */
